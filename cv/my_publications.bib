@article{braadland_-adrenergic_2015,
	title = {β-{Adrenergic} receptor signaling in prostate cancer},
	volume = {4},
	issn = {2234-943X},
	url = {https://www.frontiersin.org/journals/oncology/articles/10.3389/fonc.2014.00375/full},
	doi = {10.3389/fonc.2014.00375},
	abstract = {Enhanced sympathetic signaling, often associated with obesity and chronic stress, is increasingly acknowledged as a contributor to cancer aggressiveness. In prostate cancer, intact sympathetic nerves are critical for tumor formation, and sympathectomy induces apoptosis and blocks tumor growth. Perineural invasion, involving enrichment of intra-prostatic nerves, is frequently observed in prostate cancer and is associated with poor prognosis. β2-adrenergic receptor, the most abundant receptor for sympathetic signals in prostate luminal cells, has been shown to regulate trans-differentiation of cancer cells to neuroendocrine-like cells and to affect apoptosis, angiogenesis, EMT, migration and metastasis. Epidemiologic studies have shown that use of β-blockers, inhibiting β-adrenergic receptor activity, is associated with reduced prostate cancer specific mortality. In this review we aim to present an overview on how β-adrenergic receptor and its downstream signaling cascade influence the development of aggressive prostate cancer, primarily through regulating neuroendocrine differentiation.},
	language = {English},
	urldate = {2026-10-29},
	journal = {Front. Oncol.},
	publisher = {Frontiers},
	author = {Braadland, Peder Rustøen and Ramberg, Håkon André and Grytli, Helene Hartvedt and Taskén, Kristin Austlid},
	month = jan,
	year = {2015},
	keywords = {ADRB2, adrenergic, Angiogenesis, Apoptosis, BAD, Bcl-2, beta-blocker, cAMP, CREB, EMT, ENO2, Epinephrine, EZH2, ICI118.551, metastasis, NED, neuroendocrine differentiation, Norepinephrine, NSE, PAK4, Perineural invasion, PKA, Propanolol, prostate cancer, protein kinase A, RhoA, ROCK, stress, Tmprss2-erg, VEGF, β-adrenergic receptor},
	file = {Full Text:C\:\\Users\\pederbra\\Zotero\\storage\\H3TXKD4V\\Braadland et al. - 2015 - β-Adrenergic receptor signaling in prostate cancer.pdf:application/pdf},
}

