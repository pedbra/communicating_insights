	journal = {medRxiv},
	author = {Harris, Danielle M. M. and Bourgonje, Arno R. and Braadland, Peder Rustøen and McShane, Cathy and Welz, Lina and Waschina, Silvio and Ibing, Susanne and Tran, Florian and Sands, Bruce E. and Dubinsky, Marla and Suarez-Farinas, Mayte and Argmann, Carmen and Ueland, Per M and McCann, Adrian and Detlie, Trond Espen and Bengtson, May-Bente and Kristensen, Vendel and Franke, Andre and Colombel, Jean-Frédéric and Rosenstiel, Philip and Croitoru, Kenneth and Sokol, Harry and Turpin, Williams and Hov, Johannes Roksund and Høivik, Marte Lie and Ungaro, Ryan C. and Schreiber, Stefan and Aden, Konrad},
	month = may,
	year = {2026},
	pmcid = {PMC13174703},
	pmid = {42145595},
	pages = {2026.05.03.26352309},
	file = {Accepted Version:C\:\\Users\\pederbra\\Zotero\\storage\\7AP4Y4CX\\Harris et al. - 2026 - Tryptophan pathway metabotypes associate with disease activity and immune-metabolic dysfunction in i.pdf:application/pdf},
}

